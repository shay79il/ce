# MLRun CE Install - Environment Configuration
# ================================================
# Copy this file to .env and fill in your values:
#
#   cp .env.example .env
#   vi .env
#
# The .env file is automatically loaded by the install script.
# It is excluded from version control via .gitignore -- NEVER commit it.

# ---------------------------------------------------------------------------
# Required (the script will not run without these)
# ---------------------------------------------------------------------------

# DNS domain for ingress hostnames
# Hostnames are generated as: <service>.<namespace>.<cluster>.<domain>
DOMAIN=""

# Kubernetes ingress class name
# Common values: nginx, traefik, haproxy, alb
INGRESS_CLASS=""

# ---------------------------------------------------------------------------
# Optional - Helm install settings (have sensible defaults)
# ---------------------------------------------------------------------------

# nginx-ingress controller version to install (default: v1.11.3)
# Set to empty string to skip automatic nginx-ingress installation
# INGRESS_NGINX_VERSION="v1.11.3"

# Kubernetes storage class for dynamically provisioned PVCs (default: nfs-client)
# Common values: nfs-client, standard, gp3, local-path, longhorn
# STORAGE_CLASS="nfs-client"

# Kafka PVC storage size (default: 8Gi)
# KAFKA_PVC_SIZE="8Gi"

# Helm TLS verification (default: 1)
# 1 = skip TLS verification (--insecure-skip-tls-verify), suitable for dev/test
# 0 = strict TLS verification, recommended for production
# INSECURE_TLS=1

# ---------------------------------------------------------------------------
# Optional - Remote cluster connection
# ---------------------------------------------------------------------------

# Remote cluster name (e.g., vmdev235ig4)
# Required for --remote connections; used in kubeconfig path and ingress hostnames
# For local clusters this is auto-detected from the kube context
# CLUSTER_NAME=""

# ---------------------------------------------------------------------------
# Optional - Kubeconfig & SSH tunnel (used by create_kubeconfig.sh)
# ---------------------------------------------------------------------------

# Path to kubeconfig file (default: ~/.kube/config_<cluster-name>)
# Both scripts respect this -- keeps your default kubeconfig untouched
# KUBECONFIG="${HOME}/.kube/config_mycluster"

# Local port for SSH tunnel to K8s API server (default: 6443)
# LOCAL_TUNNEL_PORT=6443

# Kubernetes service account name for remote access (default: kubernetes)
# K8S_SA_NAME="kubernetes"

# Skip TLS verification in generated kubeconfig (default: true)
# SKIP_TLS_VERIFY=true

# ---------------------------------------------------------------------------
# Optional - SSH / secrets
# ---------------------------------------------------------------------------

# SSH password for remote operations (default: empty = use SSH keys)
# Used by both scripts for sshpass-based SSH connections
# SUDO_PASS=""
